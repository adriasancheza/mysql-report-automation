# Copy this file to .env and fill in real values. .env is gitignored.

# SQLAlchemy connection URL.
# MySQL (PyMySQL driver):
#   DATABASE_URL=mysql+pymysql://user:password@localhost:3306/sales_db
# SQLite (used by tests and the demo):
#   DATABASE_URL=sqlite:///demo.db
DATABASE_URL=sqlite:///demo.db

# SMTP settings used to email generated reports.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=reports@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=reports@example.com
SMTP_USE_TLS=true
